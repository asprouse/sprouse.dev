---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  /** Path to an image relative to the site root, used for OG/Twitter previews. Defaults to /og.png. */
  ogImage?: string;
}

const { title, description, ogImage = '/og.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://sprouse.dev');
const ogImageUrl = new URL(ogImage, Astro.site ?? 'https://sprouse.dev').toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical.toString()} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="sprouse.dev" />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImageUrl} />

    <ClientRouter />
  </head>
  <body class="text-base leading-[1.65]">
    <slot />
  </body>
</html>
