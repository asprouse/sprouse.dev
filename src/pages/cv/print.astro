---
// Inter Variable (latin subsets) is declared in global.css
import '../../styles/global.css';
import {
  CURRENT_ERA_FROM,
  deriveSkills,
  formatDateRange,
  resume,
  slugifyCompany
} from '../../lib/resume';
import type { TechCategory } from '../../types/resume';
import TailorPanel from '../../components/TailorPanel';
import { VARIANTS, type VariantSlug, VARIANT_ORDER } from '../../lib/variants';

// SSR: the ?lens query param picks the variant. Default is cto.
const lensParam = Astro.url.searchParams.get('lens');
const lens: VariantSlug = VARIANT_ORDER.includes(lensParam as VariantSlug)
  ? (lensParam as VariantSlug)
  : 'cto';
const variant = VARIANTS[lens];

const { person, summary, experience, education } = resume;
const fullName = `${person.first} ${person.last}`;
const currentRole = experience.find((r) => r.dateRange.to === null);
const currentLine = currentRole ? `${currentRole.title} · ${currentRole.company}` : '';

const currentEra = experience.filter((r) => r.dateRange.from >= CURRENT_ERA_FROM);
const retrospective = experience.filter((r) => r.dateRange.from < CURRENT_ERA_FROM);

// Derived from resume.json — every chip has a project. Merges some TechEntry
// categories into denser print buckets.
const PRINT_GROUPS: { label: string; categories: TechCategory[] }[] = [
  { label: 'Languages', categories: ['language'] },
  { label: 'Frameworks', categories: ['framework'] },
  { label: 'AI / LLM', categories: ['ai'] },
  { label: 'Platforms', categories: ['platform'] },
  { label: 'Infrastructure & Tooling', categories: ['tooling', 'library'] },
  { label: 'Protocols & Concepts', categories: ['protocol', 'concept'] }
];

const derivedSkills = deriveSkills();
const skillGroups = PRINT_GROUPS.map((g) => ({
  label: g.label,
  items: g.categories.flatMap((c) => derivedSkills[c].map((s) => s.tech.name))
})).filter((g) => g.items.length > 0);

// Summary lead = the variant's tagline. Closer = its openTo. Falls back to
// resume.json summary if the resume has no current role (forked clones).
const summaryText = currentRole ? `${variant.tagline} ${variant.openTo}` : summary;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{`${fullName} — CV (${variant.label})`}</title>
    <meta name="description" content={variant.metaDescription} />

    <style>
      @page {
        size: letter;
        margin: 0.55in 0.6in;
      }

      :root {
        --cv-ink: #0c0a09;
        --cv-muted: #57534e;
        --cv-rule: #d6d3d1;
        --cv-accent: #ea580c;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        background: #f5f5f4;
        color: var(--cv-ink);
        font-family:
          'Inter Variable',
          -apple-system,
          BlinkMacSystemFont,
          system-ui,
          sans-serif;
        font-feature-settings: 'ss01', 'cv11';
        font-size: 10.5pt;
        line-height: 1.4;
        -webkit-font-smoothing: antialiased;
      }

      .page {
        max-width: 8.5in;
        margin: 0.25in auto 0.5in;
        background: #ffffff;
        padding: 0.55in 0.6in;
        box-shadow:
          0 1px 3px rgba(12, 10, 9, 0.1),
          0 4px 12px rgba(12, 10, 9, 0.06);
      }

      @media print {
        html,
        body {
          background: #ffffff;
        }
        .page {
          margin: 0;
          padding: 0;
          max-width: none;
          box-shadow: none;
        }
        .no-print {
          display: none !important;
        }
      }

      .toolbar {
        max-width: 8.5in;
        margin: 0.25in auto 0;
        padding: 0 0.6in;
        display: flex;
        gap: 12px;
        align-items: center;
        font-size: 13px;
        color: var(--cv-muted);
      }

      .toolbar a,
      .toolbar button {
        appearance: none;
        background: none;
        border: 1px solid var(--cv-rule);
        color: var(--cv-ink);
        padding: 6px 12px;
        border-radius: 6px;
        font: inherit;
        cursor: pointer;
        text-decoration: none;
      }
      .toolbar button.primary {
        background: var(--cv-accent);
        color: #ffffff;
        border-color: var(--cv-accent);
      }
      .toolbar-right {
        margin-left: auto;
        display: flex;
        gap: 12px;
        align-items: center;
      }
      header.cv-hero {
        margin-bottom: 1.1em;
      }

      h1 {
        margin: 0 0 0.15em;
        font-size: 24pt;
        font-weight: 700;
        letter-spacing: -0.025em;
        line-height: 1.05;
      }

      .role-line {
        margin: 0 0 0.35em;
        font-size: 11.5pt;
        color: var(--cv-muted);
      }

      .contact {
        margin: 0;
        font-size: 10pt;
        color: var(--cv-muted);
      }
      .contact a {
        color: var(--cv-ink);
        text-decoration: none;
      }

      .summary {
        margin: 1em 0 0;
        font-size: 10.5pt;
        line-height: 1.5;
      }

      h2.section {
        margin: 1.4em 0 0.4em;
        padding-bottom: 0.2em;
        font-size: 9pt;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--cv-muted);
        border-bottom: 1px solid var(--cv-rule);
        break-after: avoid-page;
        page-break-after: avoid;
      }

      .role {
        margin: 0.7em 0 1em;
      }

      .role-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 12px;
        margin-bottom: 0.15em;
        break-after: avoid-page;
        page-break-after: avoid;
      }
      .role-name {
        font-size: 11.5pt;
        font-weight: 700;
        letter-spacing: -0.005em;
      }
      .role-meta {
        font-size: 9.5pt;
        color: var(--cv-muted);
        white-space: nowrap;
      }

      .role-title-line {
        margin: 0 0 0.45em;
        font-size: 10pt;
        color: var(--cv-muted);
        font-style: italic;
      }

      .role-summary {
        margin: 0.35em 0 0.55em;
        font-size: 10pt;
      }
      .role-summary a {
        color: var(--cv-ink);
        text-decoration: underline;
        text-decoration-color: var(--cv-rule);
      }

      .project {
        margin: 0.45em 0;
        page-break-inside: avoid;
      }
      .project-title {
        display: inline;
        font-weight: 600;
        font-size: 10pt;
      }
      .project-title::after {
        content: ' — ';
        color: var(--cv-muted);
        font-weight: 400;
      }
      .project-description {
        display: inline;
        font-size: 10pt;
      }
      .project-description a {
        color: var(--cv-ink);
        text-decoration: underline;
        text-decoration-color: var(--cv-rule);
      }
      .project-tech {
        display: block;
        margin-top: 0.2em;
        font-size: 8.5pt;
        color: var(--cv-muted);
        font-style: italic;
      }

      .retro-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 12px;
        margin: 0.3em 0;
        font-size: 9.5pt;
      }
      .retro-name {
        font-weight: 600;
      }
      .retro-meta {
        color: var(--cv-muted);
        white-space: nowrap;
      }
      .retro-title {
        color: var(--cv-muted);
      }

      .skill-row {
        margin: 0.25em 0;
        font-size: 10pt;
      }
      .skill-label {
        font-weight: 600;
        color: var(--cv-muted);
        display: inline-block;
        min-width: 11em;
      }

      .edu-row,
      .oss-row {
        margin: 0.3em 0;
        font-size: 10pt;
      }
      .edu-row strong,
      .oss-row strong {
        font-weight: 600;
      }
      .oss-row a {
        color: var(--cv-ink);
        text-decoration: underline;
        text-decoration-color: var(--cv-rule);
      }

      /* Project list uses flex so client-side reordering can use CSS order */
      .project-list {
        display: flex;
        flex-direction: column;
      }

      /* Tailor visual diff — screen only, never affects print output */
      .tailor-badge {
        margin: 0.5em 0 0;
        font-size: 9.5pt;
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--cv-muted);
      }
      .tailor-badge-variant {
        background: color-mix(in oklab, var(--cv-accent) 14%, transparent);
        color: var(--cv-accent);
        padding: 2px 8px;
        border-radius: 999px;
        font-weight: 600;
        font-size: 9pt;
        text-transform: capitalize;
      }
      .tailor-badge-why,
      .tailor-badge-clear {
        appearance: none;
        background: none;
        border: 1px solid var(--cv-rule);
        color: var(--cv-muted);
        padding: 2px 8px;
        font-size: 9pt;
        border-radius: 4px;
        cursor: pointer;
        font-family: inherit;
      }
      .tailor-rationale {
        margin: 0.6em 0 0;
        padding: 0.7em 0.9em;
        background: color-mix(in oklab, var(--cv-accent) 6%, transparent);
        border-left: 2px solid var(--cv-accent);
        font-size: 9.5pt;
        line-height: 1.5;
        color: var(--cv-ink);
      }

      .project.tailor-hidden {
        opacity: 0.32;
        position: relative;
      }
      .project.tailor-hidden .project-title,
      .project.tailor-hidden .project-description {
        text-decoration: line-through;
        text-decoration-color: var(--cv-muted);
      }
      .project.tailor-promoted::before {
        content: '↑ promoted';
        display: inline-block;
        margin-right: 6px;
        padding: 1px 6px;
        background: color-mix(in oklab, var(--cv-accent) 14%, transparent);
        color: var(--cv-accent);
        font-size: 7.5pt;
        font-weight: 600;
        border-radius: 3px;
        vertical-align: 2px;
      }
      .skill-item.tailor-emphasis {
        color: var(--cv-accent);
        font-weight: 600;
      }
      .summary.tailor-replaced {
        position: relative;
      }
      .summary.tailor-replaced::after {
        content: 'tailored';
        position: absolute;
        top: -0.2em;
        right: 0;
        font-size: 7.5pt;
        color: var(--cv-accent);
        background: color-mix(in oklab, var(--cv-accent) 12%, transparent);
        padding: 1px 6px;
        border-radius: 3px;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      @media print {
        .tailor-badge,
        .tailor-rationale {
          display: none !important;
        }
        .project.tailor-hidden {
          display: none !important;
        }
        .project.tailor-promoted::before {
          display: none !important;
        }
        .skill-item.tailor-emphasis {
          color: var(--cv-ink);
          font-weight: 600;
        }
        .summary.tailor-replaced::after {
          display: none !important;
        }
      }
    </style>
  </head>
  <body>
    <div class="toolbar no-print">
      <a href={`/cv?lens=${variant.slug}`}>← Back to CV</a>
      <div class="toolbar-right">
        <TailorPanel client:load />
        <button type="button" class="primary" onclick="window.print()">
          Print / save as PDF
        </button>
      </div>
    </div>

    <article class="page">
      <header class="cv-hero">
        <h1>{fullName}</h1>
        <p class="role-line">{currentLine} · {person.location.city}, {person.location.state}</p>
        <p class="contact">
          <a href={`mailto:${person.email}`}>{person.email}</a> ·{' '}
          <a href={person.links.github}>github.com/asprouse</a> ·{' '}
          <a href={person.links.linkedin}>linkedin.com/in/andrewsprouse</a> ·{' '}
          <a href={person.links.website}>sprouse.dev</a>
        </p>
        <p class="summary" data-original-summary={summaryText}>{summaryText}</p>
        <div class="tailor-badge no-print" hidden>
          <span class="tailor-badge-label">Tailored to:</span>
          <span class="tailor-badge-variant" data-tailor-variant></span>
          <button type="button" class="tailor-badge-why" data-tailor-why-toggle>Why?</button>
          <button type="button" class="tailor-badge-clear" data-tailor-clear>Clear</button>
        </div>
        <p class="tailor-rationale no-print" data-tailor-rationale hidden></p>
      </header>

      <section>
        <h2 class="section">Experience</h2>
        {
          currentEra.map((role) => (
            <div class="role" data-role-slug={slugifyCompany(role.company)}>
              <div class="role-header">
                <span class="role-name">{role.company}</span>
                <span class="role-meta">
                  {formatDateRange(role.dateRange.from, role.dateRange.to)} · {role.location.city},{' '}
                  {role.location.state}
                </span>
              </div>
              <p class="role-title-line">{role.title}</p>

              {role.description && <p class="role-summary" set:html={role.description} />}

              <div class="project-list">
                {role.projects.map((project, idx) => (
                  <div class="project" data-project-index={idx} style={`order: ${idx};`}>
                    {project.title && <span class="project-title">{project.title}</span>}
                    <span class="project-description" set:html={project.description} />
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </section>

      {
        retrospective.length > 0 && (
          <section>
            <h2 class="section">Career retrospective (2004–2014)</h2>
            {retrospective.map((role) => (
              <div class="retro-row">
                <span>
                  <span class="retro-name">{role.company}</span>{' '}
                  <span class="retro-title">— {role.title}</span>
                </span>
                <span class="retro-meta">
                  {formatDateRange(role.dateRange.from, role.dateRange.to)} · {role.location.city},{' '}
                  {role.location.state}
                </span>
              </div>
            ))}
          </section>
        )
      }

      <section>
        <h2 class="section">Skills</h2>
        {
          skillGroups.map((g) => (
            <p class="skill-row">
              <span class="skill-label">{g.label}</span>
              {g.items.map((item, idx) => (
                <>
                  <span class="skill-item" data-skill={item}>
                    {item}
                  </span>
                  {idx < g.items.length - 1 && <span class="skill-sep"> · </span>}
                </>
              ))}
            </p>
          ))
        }
      </section>

      <section>
        <h2 class="section">Education</h2>
        {
          education.map((e) => (
            <p class="edu-row">
              <strong>{e.degree}</strong>, {e.school}
              {e.honors && e.honors.length > 0 && <> — {e.honors.join(', ')}</>}
              {' · '}
              {e.date}
            </p>
          ))
        }
      </section>
    </article>
  </body>
</html>
