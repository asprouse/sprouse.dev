---
import Layout from "../layouts/Layout.astro";
import Chat from "../components/Chat";
import Portrait from "../components/Portrait.astro";
import RoleCard from "../components/RoleCard.astro";
import SkillsMatrix from "../components/SkillsMatrix.astro";
import { resume } from "../lib/resume";

const { person, summary, experience, openSource } = resume;
const fullName = `${person.first} ${person.last}`;
const currentRole = experience.find((r) => r.dateRange.to === null);
const headline = currentRole ? `${currentRole.title} · ${currentRole.company}` : "";
---

<Layout title={`${fullName} — Resume`} description={summary}>
    <main class="max-w-page mx-auto px-6 pt-20 pb-28">
        <header class="grid grid-cols-[1fr_auto] gap-8 items-start mb-10 max-[600px]:grid-cols-1 max-[600px]:gap-5">
            <div class="min-w-0 max-[600px]:order-2">
                <h1 class="text-[clamp(2rem,5vw,2.75rem)] font-bold tracking-[-0.035em] leading-[1.05] m-0 mb-3">
                    {fullName}
                </h1>
                {headline && <p class="text-[17px] m-0 mb-2 text-muted">{headline}</p>}
                <p class="text-sm text-muted m-0">
                    {person.location.city}, {person.location.state} ·{" "}
                    <a href={`mailto:${person.email}`}>{person.email}</a> ·{" "}
                    <a href={person.links.github} rel="noopener">GitHub</a> ·{" "}
                    <a href={person.links.linkedin} rel="noopener">LinkedIn</a>
                </p>
                <p class="text-[17px] leading-relaxed mt-6 max-w-[62ch] text-muted">
                    {summary}
                </p>
            </div>
            <div class="justify-self-end max-[600px]:justify-self-start max-[600px]:order-1">
                <Portrait />
            </div>
        </header>

        <h2 class="section-label mt-12 mb-5">Experience</h2>
        {experience.map((role) => <RoleCard role={role} />)}

        <h2 class="section-label mt-12 mb-5">Skills</h2>
        <SkillsMatrix />

        {
            openSource.length > 0 && (
                <>
                    <h2 class="section-label mt-12 mb-5">Open Source</h2>
                    {openSource.map((entry) => (
                        <article class="mb-4">
                            <h3 class="text-lg font-semibold tracking-tight mb-1">
                                <a href={entry.url} rel="noopener">{entry.name}</a>
                            </h3>
                            <p class="m-0">{entry.description}</p>
                        </article>
                    ))}
                </>
            )
        }

        <h2 class="section-label mt-12 mb-5">Talk to me</h2>
        <Chat client:load />
    </main>
</Layout>
