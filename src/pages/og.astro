---
// Standalone OG card layout — captured at 1200x630 to produce public/og.png.
// Run `npm run gen:og` after editing andrew.yml to refresh the PNG; the
// content here is data-driven so the page always reflects the current YAML.
import '../styles/global.css';
import { resume } from '../lib/resume';
import { VARIANTS } from '../lib/variants';

export const prerender = true;

const { person, experience } = resume;
const fullName = `${person.first} ${person.last}`;
const currentRole = experience.find((r) => r.dateRange.to === null);
const roleLine = currentRole
  ? `${currentRole.title} · ${currentRole.company} · ${person.location.city}, ${person.location.state}`
  : `${person.location.city}, ${person.location.state}`;
// The CTO variant's openTo is the canonical "what I'm open to" line.
const openTo = VARIANTS.cto.openTo;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>OG card</title>
    <style>
      html,
      body {
        margin: 0;
        padding: 0;
        width: 1200px;
        height: 630px;
        overflow: hidden;
        background: #fafaf9;
        color: #0c0a09;
        font-family: 'Inter Variable', ui-sans-serif, system-ui, sans-serif;
        font-feature-settings: 'ss01', 'cv11';
        -webkit-font-smoothing: antialiased;
      }

      .card {
        width: 1200px;
        height: 630px;
        display: grid;
        grid-template-columns: 380px 1fr;
        gap: 64px;
        padding: 80px 80px 80px 64px;
        box-sizing: border-box;
      }

      .portrait {
        width: 300px;
        height: 400px;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 2px 12px rgba(12, 10, 9, 0.08);
        overflow: hidden;
        align-self: center;
      }
      .portrait img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .text {
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      h1 {
        font-size: 86px;
        font-weight: 700;
        letter-spacing: -0.035em;
        line-height: 1.02;
        margin: 0 0 18px;
      }

      .role {
        font-size: 30px;
        color: #57534e;
        margin: 0 0 36px;
      }

      .rule {
        width: 110px;
        height: 5px;
        background: var(--color-brand);
        border-radius: 2px;
        margin: 0 0 28px;
      }

      .summary {
        font-size: 26px;
        color: #0c0a09;
        line-height: 1.4;
        margin: 0;
        max-width: 38ch;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <div class="portrait">
        <img
          src="/illustration/portrait.jpg"
          alt="Pencil-and-watercolor illustration of Andrew Sprouse."
        />
      </div>
      <div class="text">
        <h1>{fullName}</h1>
        <p class="role">{roleLine}</p>
        <div class="rule"></div>
        <p class="summary">{openTo}</p>
      </div>
    </div>
  </body>
</html>
