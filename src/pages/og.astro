---
// Standalone OG card layout — captured at 1200x630 to produce public/og.png.
// This page exists so the OG image can be regenerated by visiting /og in the
// dev server and screenshotting at 1200x630.
import '../styles/global.css';

export const prerender = true;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>OG card</title>
    <style>
      html,
      body {
        margin: 0;
        padding: 0;
        width: 1200px;
        height: 630px;
        overflow: hidden;
        background: #fafaf9;
        color: #0c0a09;
        font-family: 'Inter Variable', ui-sans-serif, system-ui, sans-serif;
        font-feature-settings: 'ss01', 'cv11';
        -webkit-font-smoothing: antialiased;
      }

      .card {
        width: 1200px;
        height: 630px;
        display: grid;
        grid-template-columns: 380px 1fr;
        gap: 64px;
        padding: 80px 80px 80px 64px;
        box-sizing: border-box;
      }

      .portrait {
        width: 300px;
        height: 400px;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 2px 12px rgba(12, 10, 9, 0.08);
        overflow: hidden;
        align-self: center;
      }
      .portrait img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .text {
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      h1 {
        font-size: 86px;
        font-weight: 700;
        letter-spacing: -0.035em;
        line-height: 1.02;
        margin: 0 0 18px;
      }

      .role {
        font-size: 30px;
        color: #57534e;
        margin: 0 0 36px;
      }

      .rule {
        width: 110px;
        height: 5px;
        background: #ea580c;
        border-radius: 2px;
        margin: 0 0 28px;
      }

      .summary {
        font-size: 26px;
        color: #0c0a09;
        line-height: 1.4;
        margin: 0 0 32px;
        max-width: 38ch;
      }

      .url {
        font-size: 24px;
        color: #57534e;
        letter-spacing: 0.01em;
        margin: 0;
      }
      .url strong {
        color: #0c0a09;
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <div class="portrait">
        <img
          src="/illustration/portrait.jpg"
          alt="Pencil-and-watercolor illustration of Andrew Sprouse."
        />
      </div>
      <div class="text">
        <h1>Andrew Sprouse</h1>
        <p class="role">Co-Founder &amp; CTO · TakeShape · Brooklyn, NY</p>
        <div class="rule"></div>
        <p class="summary">
          Building AI agent infrastructure. Open to a new role: CTO, Principal Engineer, or
          technical co-founder.
        </p>
        <p class="url"><strong>sprouse.dev</strong></p>
      </div>
    </div>
  </body>
</html>
