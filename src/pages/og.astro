---
// Standalone OG card layout — captured at 1200x630 to produce public/og.png.
// Run `npm run gen:og` after editing andrew.yml to refresh the PNG. Content
// matches the homepage's name + tagline so the social card and the landing
// page give the same first impression.
import '../styles/global.css';
import { Image } from 'astro:assets';
import portraitImg from '../assets/portrait.jpg';
import { resume } from '../lib/resume';

export const prerender = true;

const { person, tagline } = resume;
const fullName = `${person.first} ${person.last}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>OG card</title>
    <style>
      html,
      body {
        margin: 0;
        padding: 0;
        width: 1200px;
        height: 630px;
        overflow: hidden;
        background: #fafaf9;
        color: #0c0a09;
        font-family: 'Inter Variable', ui-sans-serif, system-ui, sans-serif;
        font-feature-settings: 'ss01', 'cv11';
        -webkit-font-smoothing: antialiased;
      }

      .card {
        width: 1200px;
        height: 630px;
        display: grid;
        grid-template-columns: 380px 1fr;
        gap: 64px;
        padding: 80px 80px 80px 64px;
        box-sizing: border-box;
      }

      .portrait {
        width: 300px;
        height: 400px;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 2px 12px rgba(12, 10, 9, 0.08);
        overflow: hidden;
        align-self: center;
      }
      .portrait img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .text {
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      h1 {
        font-size: 86px;
        font-weight: 700;
        letter-spacing: -0.035em;
        line-height: 1.02;
        margin: 0 0 28px;
      }

      .tagline {
        font-size: 36px;
        color: #0c0a09;
        line-height: 1.25;
        font-weight: 500;
        letter-spacing: -0.01em;
        margin: 0;
        max-width: 22ch;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <div class="portrait">
        <Image
          src={portraitImg}
          alt="Pencil-and-watercolor illustration of Andrew Sprouse."
          width={300}
          height={400}
        />
      </div>
      <div class="text">
        <h1>{fullName}</h1>
        <p class="tagline">{tagline}</p>
      </div>
    </div>
  </body>
</html>
