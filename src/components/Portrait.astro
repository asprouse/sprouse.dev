---
import promptText from '../../illustration/prompt.txt?raw';
---

<div class="portrait group relative inline-block w-[180px] max-md:w-[140px]">
  <button
    type="button"
    class="font-inherit portrait-trigger relative m-0 block w-full cursor-pointer appearance-none border-none bg-transparent p-0 text-center"
    aria-label="Show the source photo and AI prompt used to create this illustration"
    aria-expanded="false"
  >
    <img
      src="/illustration/portrait.jpg"
      alt="Pencil-and-watercolor illustration of Andrew Sprouse generated from a photograph."
      width="180"
      height="240"
      class="bg-surface block h-auto w-full rounded-lg shadow-sm transition-all duration-200 ease-out group-focus-within:-translate-y-0.5 group-focus-within:shadow-lg group-hover:-translate-y-0.5 group-hover:shadow-lg"
    />
    <span
      class="bg-accent text-accent-ink dot-pulse absolute right-2 bottom-2 flex h-7 w-7 items-center justify-center rounded-full text-[14px] font-bold shadow-md transition-transform group-hover:scale-110"
      aria-hidden="true"
    >
      ?
    </span>
  </button>

  <div
    class="reveal border-rule bg-surface pointer-events-none absolute top-[calc(100%+0.75rem)] right-0 z-10 w-[420px] -translate-y-2 rounded-xl border p-5 opacity-0 shadow-2xl transition-all duration-200 ease-out group-focus-within:pointer-events-auto group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:pointer-events-auto group-hover:translate-y-0 group-hover:opacity-100 group-[.open]:pointer-events-auto group-[.open]:translate-y-0 group-[.open]:opacity-100 max-md:fixed max-md:inset-x-4 max-md:top-auto max-md:right-auto max-md:bottom-4 max-md:w-auto"
    role="region"
    aria-label="Source photo and prompt"
  >
    <div class="grid grid-cols-[120px_1fr] gap-4 max-md:grid-cols-[100px_1fr] max-md:gap-3">
      <figure class="m-0">
        <img
          src="/illustration/original.jpeg"
          alt="Original photograph of Andrew Sprouse, used as input to the illustration prompt."
          width="160"
          height="213"
          loading="lazy"
          class="block h-auto w-full rounded-md"
        />
        <figcaption class="text-muted mt-1.5 text-[11px] tracking-wider uppercase">
          Original photo
        </figcaption>
      </figure>
      <div>
        <p class="text-muted mt-0 mb-1.5 text-[11px] font-semibold tracking-wider uppercase">
          Prompt to GPT-4o image
        </p>
        <pre
          class="text-ink m-0 max-h-[280px] overflow-y-auto font-mono text-[11px] leading-[1.55] break-words whitespace-pre-wrap max-md:max-h-[200px]">{promptText.trim()}</pre>
      </div>
    </div>
  </div>
</div>

<style>
  .dot-pulse {
    animation: dot-pulse 2s ease-in-out infinite;
  }

  @keyframes dot-pulse {
    0%,
    100% {
      opacity: 0.4;
    }
    50% {
      opacity: 1;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.portrait-trigger').forEach((btn) => {
    const wrapper = btn.parentElement!;
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const isOpen = wrapper.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(isOpen));
    });
  });

  document.addEventListener('click', (e) => {
    document.querySelectorAll('.portrait.open').forEach((wrapper) => {
      if (!wrapper.contains(e.target as Node)) {
        wrapper.classList.remove('open');
        wrapper.querySelector('.portrait-trigger')?.setAttribute('aria-expanded', 'false');
      }
    });
  });
</script>
