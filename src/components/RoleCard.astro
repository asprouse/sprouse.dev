---
import TechChip from './TechChip.astro';
import { formatDateRange, slugifyCompany } from '../lib/resume';
import type { ExperienceEntry } from '../types/resume';

interface Props {
  role: ExperienceEntry;
}

const { role } = Astro.props;
const slug = slugifyCompany(role.company);
---

<article
  id={`role-${slug}`}
  data-role-slug={slug}
  class="role border-rule scroll-mt-24 border-t py-7 transition-colors first:border-t-0 first:pt-0"
>
  <h3 class="mb-1 text-lg font-semibold tracking-tight">{role.company}</h3>

  <div class="text-muted mb-3.5 flex flex-wrap gap-x-2.5 gap-y-1 text-[13px]">
    <span class="whitespace-nowrap">{role.title}</span>
    <span class="text-muted-2">·</span>
    <span class="whitespace-nowrap">{formatDateRange(role.dateRange.from, role.dateRange.to)}</span>
    <span class="text-muted-2">·</span>
    <span class="whitespace-nowrap">{role.location.city}, {role.location.state}</span>
  </div>

  {role.description && <p class="m-0" set:html={role.description} />}

  {
    role.impactBullets && role.impactBullets.length > 0 && (
      <ul class="mt-4 list-none space-y-1.5 p-0">
        {role.impactBullets.map((bullet) => (
          <li class="text-ink flex items-start gap-2.5 text-[15px] leading-[1.45]">
            <span
              class="bg-accent mt-[0.55em] h-1.5 w-1.5 shrink-0 rounded-full"
              aria-hidden="true"
            />
            <span set:html={bullet} />
          </li>
        ))}
      </ul>
    )
  }

  <div class="project-list flex flex-col">
    {
      role.projects.map((project, idx) => (
        <details
          open
          class="project group/project mt-5"
          data-project-index={idx}
          style={`order: ${idx};`}
        >
          <summary class="hover:[&_.project-title]:text-accent -ml-1 flex cursor-pointer list-none items-center gap-2 select-none">
            <svg
              class="text-muted-2 h-3 w-3 shrink-0 transition-transform duration-150 group-open/project:rotate-90"
              viewBox="0 0 12 12"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M4.5 2.5L8 6l-3.5 3.5" />
            </svg>
            {project.title && (
              <h4 class="project-title m-0 text-[15px] font-semibold tracking-tight transition-colors">
                {project.title}
              </h4>
            )}
          </summary>
          <div class="border-rule mt-1.5 ml-1.5 border-l pl-4">
            <p class="m-0" set:html={project.description} />
            {project.technologies.length > 0 && (
              <div class="mt-2.5 flex flex-wrap gap-1.5">
                {project.technologies.map((slug) => (
                  <TechChip slug={slug} />
                ))}
              </div>
            )}
          </div>
        </details>
      ))
    }
  </div>
</article>

<style>
  .role.role-flash {
    animation: role-flash 1.6s ease-out;
  }

  @keyframes role-flash {
    0% {
      background-color: transparent;
    }
    20% {
      background-color: color-mix(in oklab, var(--color-accent) 14%, transparent);
    }
    100% {
      background-color: transparent;
    }
  }

  .project > summary::-webkit-details-marker {
    display: none;
  }
</style>
