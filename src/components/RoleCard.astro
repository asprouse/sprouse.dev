---
import TechChip from './TechChip.astro';
import { formatDateRange, slugifyCompany } from '../lib/resume';
import type { ExperienceEntry } from '../types/resume';

interface Props {
  role: ExperienceEntry;
}

const { role } = Astro.props;
const slug = slugifyCompany(role.company);
---

<article
  id={`role-${slug}`}
  data-role-slug={slug}
  class="role border-rule scroll-mt-24 border-t py-7 transition-colors first:border-t-0 first:pt-0"
>
  <h3 class="mb-1 text-lg font-semibold tracking-tight">{role.company}</h3>

  <div class="text-muted mb-3.5 flex flex-wrap gap-x-2.5 gap-y-1 text-[13px]">
    <span class="whitespace-nowrap">{role.title}</span>
    <span class="text-muted-2">·</span>
    <span class="whitespace-nowrap">{formatDateRange(role.dateRange.from, role.dateRange.to)}</span>
    <span class="text-muted-2">·</span>
    <span class="whitespace-nowrap">{role.location.city}, {role.location.state}</span>
  </div>

  {role.description && <p class="m-0" set:html={role.description} />}

  {
    role.projects.map((project) => (
      <div class="mt-4">
        {project.title && (
          <h4 class="m-0 mb-1 text-[15px] font-semibold tracking-tight">{project.title}</h4>
        )}
        <p class="m-0" set:html={project.description} />
        {project.technologies.length > 0 && (
          <div class="mt-2.5 flex flex-wrap gap-1.5">
            {project.technologies.map((slug) => (
              <TechChip slug={slug} />
            ))}
          </div>
        )}
      </div>
    ))
  }
</article>

<style>
  .role.role-flash {
    animation: role-flash 1.6s ease-out;
  }

  @keyframes role-flash {
    0% {
      background-color: transparent;
    }
    20% {
      background-color: color-mix(in oklab, var(--color-accent) 14%, transparent);
    }
    100% {
      background-color: transparent;
    }
  }
</style>
