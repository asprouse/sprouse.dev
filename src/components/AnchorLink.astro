---
interface Props {
  /** Fragment id WITHOUT leading hash, e.g. "role-takeshape". */
  hash: string;
  /** Accessible label, e.g. "Permalink to TakeShape". */
  label: string;
}

const { hash, label } = Astro.props;
---

<a
  href={`#${hash}`}
  class="anchor-link text-muted-2 hover:text-accent inline-flex shrink-0 items-center opacity-0 transition-opacity"
  aria-label={label}
>
  <svg
    width="14"
    height="14"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M9 17H7A5 5 0 0 1 7 7h2"></path>
    <path d="M15 7h2a5 5 0 1 1 0 10h-2"></path>
    <line x1="8" y1="12" x2="16" y2="12"></line>
  </svg>
</a>

<style is:global>
  /* Show the chain icon when the user is hovering anything inside the
     heading container that opted into the .has-anchor-link convention. */
  .has-anchor-link:hover .anchor-link,
  .anchor-link:focus-visible {
    opacity: 1;
  }
</style>

<script>
  // When an anchor link sits inside a <summary>, a bubbled click would
  // toggle the parent <details>. Stop the bubble at the anchor itself.
  // Idempotent — safe to re-run on every astro:page-load.
  function bindAnchorLinks() {
    document.querySelectorAll<HTMLAnchorElement>('a.anchor-link').forEach((el) => {
      if (el.dataset.anchorBound) return;
      el.dataset.anchorBound = 'true';
      el.addEventListener('click', (e) => e.stopPropagation());
    });
  }
  // astro:page-load fires on initial navigation too, so no immediate call needed.
  document.addEventListener('astro:page-load', bindAnchorLinks);
</script>
