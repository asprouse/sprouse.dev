---
import { marked } from 'marked';
import raw from '../../chatbot/leadership.md?raw';

const themes = raw
  .split(/^# /m)
  .map((chunk) => chunk.trim())
  .filter(Boolean)
  .map((chunk) => {
    const newline = chunk.indexOf('\n');
    const title = newline === -1 ? chunk : chunk.slice(0, newline);
    const body = newline === -1 ? '' : chunk.slice(newline + 1).trim();
    return {
      title: title.trim(),
      body: marked.parse(body) as string
    };
  });
---

<section id="leadership-philosophy" class="scroll-mt-24">
  <h2 class="section-heading mt-14 mb-2">How I run things</h2>
  <p class="text-muted mt-0 mb-6 max-w-[62ch] text-[14px]">
    Themes across hiring, decisions, communication, conflict, and leading through AI. Ask the
    chatbot to dig deeper into any of them.
  </p>

  <ul class="m-0 grid list-none grid-cols-1 gap-x-6 gap-y-5 p-0 md:grid-cols-2">
    {
      themes.map((theme) => (
        <li class="m-0">
          <h3 class="text-ink mt-0 mb-1.5 text-[15px] font-semibold tracking-tight">
            {theme.title}
          </h3>
          <div
            class="text-ink leadership-body m-0 text-[14px] leading-[1.55]"
            set:html={theme.body}
          />
        </li>
      ))
    }
  </ul>
</section>

<style>
  .leadership-body :global(p) {
    margin: 0;
  }
</style>
