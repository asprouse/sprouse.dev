---
import { deriveSkills } from '../lib/resume';
import type { TechCategory } from '../types/resume';

const skills = deriveSkills();

const VISIBLE: { key: TechCategory; label: string }[] = [
  { key: 'language', label: 'Languages' },
  { key: 'framework', label: 'Frameworks' },
  { key: 'platform', label: 'Platforms' },
  { key: 'ai', label: 'AI / LLM' },
  { key: 'tooling', label: 'Tooling' },
  { key: 'library', label: 'Libraries' },
  { key: 'protocol', label: 'Protocols' },
  { key: 'concept', label: 'Concepts' }
];

const groups = VISIBLE.map((g) => ({ ...g, items: skills[g.key] })).filter(
  (g) => g.items.length > 0
);
---

<div class="grid [grid-template-columns:repeat(auto-fit,minmax(240px,1fr))] gap-x-8 gap-y-6">
  {
    groups.map((group) => (
      <div>
        <h3 class="text-muted mb-2.5 text-xs font-semibold tracking-wider uppercase">
          {group.label}
        </h3>
        <div class="flex flex-wrap gap-1.5">
          {group.items.map((s) => (
            <span
              class:list={['chip', s.isCurrent && 'chip-current']}
              title={`${s.companies.join(', ')} · ${s.projectCount} project${s.projectCount === 1 ? '' : 's'}${s.isCurrent ? ' · currently using' : ''}`}
            >
              {s.tech.name}
            </span>
          ))}
        </div>
      </div>
    ))
  }
</div>

<p class="text-muted mt-6 max-w-[56ch] text-[13px]">
  Derived from the projects above — every chip has receipts. Hover to see where each was used;
  outlined chips are currently in use.
</p>
