---
import { VARIANTS, VARIANT_ORDER, type VariantSlug } from '../lib/variants';

interface Props {
  current: VariantSlug;
}

const { current } = Astro.props;
---

<div class="text-muted flex flex-wrap items-center gap-2 text-[13px]">
  <span>Lens</span>
  <span
    class="border-rule inline-flex flex-wrap rounded-full border p-0.5"
    role="tablist"
    aria-label="Positioning variants"
  >
    {
      VARIANT_ORDER.map((slug) => {
        const variant = VARIANTS[slug];
        const isCurrent = slug === current;
        return isCurrent ? (
          <span
            class="bg-accent text-accent-ink rounded-full px-3 py-1 text-[12px] font-semibold"
            role="tab"
            aria-selected="true"
            aria-current="page"
          >
            {variant.label}
          </span>
        ) : (
          <a
            href={variant.path}
            class="text-muted hover:bg-chip hover:text-ink rounded-full px-3 py-1 text-[12px] transition-colors"
            role="tab"
            aria-selected="false"
          >
            {variant.label}
          </a>
        );
      })
    }
  </span>
</div>
