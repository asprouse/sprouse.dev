---
import Layout from '../layouts/Layout.astro';
import Chat from './Chat';
import CompressedRoleCard from './CompressedRoleCard.astro';
import LeadershipPhilosophy from './LeadershipPhilosophy.astro';
import Portrait from './Portrait.astro';
import RoleCard from './RoleCard.astro';
import SkillsMatrix from './SkillsMatrix.astro';
import VariantSwitcher from './VariantSwitcher.astro';
import { CURRENT_ERA_FROM, resume } from '../lib/resume';
import type { Variant } from '../lib/variants';

interface Props {
  variant: Variant;
}

const { variant } = Astro.props;
const { person, experience, openSource } = resume;
const fullName = `${person.first} ${person.last}`;
const currentRole = experience.find((r) => r.dateRange.to === null);
const currentLine = currentRole ? `Currently ${currentRole.title} at ${currentRole.company}` : '';

const currentEra = experience.filter((r) => r.dateRange.from >= CURRENT_ERA_FROM);
const retrospective = experience.filter((r) => r.dateRange.from < CURRENT_ERA_FROM);
---

<Layout title={variant.metaTitle} description={variant.metaDescription}>
  <main class="max-w-page mx-auto px-6 pt-20 pb-28">
    <header
      class="mb-10 grid grid-cols-[1fr_auto] items-start gap-8 max-[600px]:grid-cols-1 max-[600px]:gap-5"
    >
      <div class="min-w-0 max-[600px]:order-1">
        <h1
          class="m-0 mb-3 text-[clamp(2rem,5vw,2.75rem)] leading-[1.05] font-bold tracking-[-0.035em]"
        >
          {fullName}
        </h1>
        {
          currentLine && (
            <p class="text-muted m-0 mb-2 text-[17px]">
              {currentLine} · {person.location.city}, {person.location.state}
            </p>
          )
        }
        <div class="mt-1 -ml-3 flex flex-wrap items-center gap-1">
          <span class="contact-chip group">
            <a href={`mailto:${person.email}`} class="text-inherit no-underline">
              {person.email}
            </a>
            <button
              type="button"
              data-copy-email={person.email}
              class="text-muted-2 hover:text-accent ml-1 rounded p-0.5 opacity-60 transition-opacity group-hover:opacity-100"
              aria-label={`Copy ${person.email} to clipboard`}
              title="Copy"
            >
              <svg
                class="copy-icon"
                width="13"
                height="13"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="5.5" y="5.5" width="8" height="8" rx="1.5"></rect>
                <path d="M3 10.5V3.5a1 1 0 0 1 1-1h7"></path>
              </svg>
              <svg
                class="check-icon hidden"
                width="13"
                height="13"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M3 8.5l3 3 7-7"></path>
              </svg>
            </button>
          </span>
          <a class="contact-chip" href={person.links.github} rel="noopener">GitHub</a>
          <a class="contact-chip" href={person.links.linkedin} rel="noopener">LinkedIn</a>
          <a class="contact-chip-primary ml-1" href="/cv">CV →</a>
        </div>

        <p class="text-ink mt-6 max-w-[62ch] text-[17px] leading-relaxed">
          {variant.headline}
        </p>

        <div
          class="border-rule bg-surface mt-5 max-w-[62ch] rounded-lg border p-3.5 text-[14px] leading-relaxed"
        >
          <span class="text-ink font-medium">{variant.openTo}</span>
        </div>

        <div class="mt-5">
          <VariantSwitcher current={variant.slug} />
        </div>
      </div>
      <div class="justify-self-end max-[600px]:order-2 max-[600px]:justify-self-start">
        <Portrait />
      </div>
    </header>

    <h2 class="section-heading mt-14 mb-6">Experience</h2>
    {currentEra.map((role) => <RoleCard role={role} />)}

    {
      retrospective.length > 0 && (
        <>
          <h2 class="section-label mt-12 mb-2">Career retrospective (2004–2014)</h2>
          <p class="text-muted mt-0 mb-4 max-w-[62ch] text-[14px]">
            Earlier work — collapsed by default. Click any to expand, or ask the chatbot to dig in.
          </p>
          {retrospective.map((role) => (
            <CompressedRoleCard role={role} />
          ))}
        </>
      )
    }

    <LeadershipPhilosophy />

    <h2 class="section-label mt-12 mb-5">Skills</h2>
    <SkillsMatrix />

    {
      openSource.length > 0 && (
        <>
          <h2 class="section-label mt-12 mb-5">Open Source</h2>
          {openSource.map((entry) => (
            <article class="mb-4">
              <h3 class="mb-1 text-lg font-semibold tracking-tight">
                <a href={entry.url} rel="noopener">
                  {entry.name}
                </a>
              </h3>
              <p class="m-0">{entry.description}</p>
            </article>
          ))}
        </>
      )
    }

    <Chat client:idle transition:persist="chat" />
  </main>
</Layout>

<script>
  // Email copy-to-clipboard. Toggles the icon to a check for ~1.5s on success
  // so the click feels acknowledged without needing a toast.
  document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      const email = btn.dataset.copyEmail;
      if (!email) return;
      try {
        await navigator.clipboard.writeText(email);
      } catch {
        return;
      }
      const copy = btn.querySelector<SVGElement>('.copy-icon');
      const check = btn.querySelector<SVGElement>('.check-icon');
      if (!copy || !check) return;
      copy.classList.add('hidden');
      check.classList.remove('hidden');
      btn.setAttribute('aria-label', 'Copied');
      window.setTimeout(() => {
        copy.classList.remove('hidden');
        check.classList.add('hidden');
        btn.setAttribute('aria-label', `Copy ${email} to clipboard`);
      }, 1500);
    });
  });
</script>
