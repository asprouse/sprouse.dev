---
import Layout from '../layouts/Layout.astro';
import Chat from './Chat';
import CompressedRoleCard from './CompressedRoleCard.astro';
import LeadershipPhilosophy from './LeadershipPhilosophy.astro';
import Portrait from './Portrait.astro';
import RoleCard from './RoleCard.astro';
import SkillsMatrix from './SkillsMatrix.astro';
import VariantSwitcher from './VariantSwitcher.astro';
import { resume } from '../lib/resume';
import type { Variant } from '../lib/variants';

interface Props {
  variant: Variant;
}

const { variant } = Astro.props;
const { person, experience, openSource } = resume;
const fullName = `${person.first} ${person.last}`;
const currentRole = experience.find((r) => r.dateRange.to === null);
const currentLine = currentRole ? `Currently ${currentRole.title} at ${currentRole.company}` : '';

const RETROSPECTIVE_CUTOFF = '2015-01';
const currentEra = experience.filter((r) => r.dateRange.from >= RETROSPECTIVE_CUTOFF);
const retrospective = experience.filter((r) => r.dateRange.from < RETROSPECTIVE_CUTOFF);
---

<Layout title={variant.metaTitle} description={variant.metaDescription}>
  <main class="max-w-page mx-auto px-6 pt-20 pb-28">
    <header
      class="mb-10 grid grid-cols-[1fr_auto] items-start gap-8 max-[600px]:grid-cols-1 max-[600px]:gap-5"
    >
      <div class="min-w-0 max-[600px]:order-1">
        <h1
          class="m-0 mb-3 text-[clamp(2rem,5vw,2.75rem)] leading-[1.05] font-bold tracking-[-0.035em]"
        >
          {fullName}
        </h1>
        {
          currentLine && (
            <p class="text-muted m-0 mb-2 text-[17px]">
              {currentLine} · {person.location.city}, {person.location.state}
            </p>
          )
        }
        <p class="text-muted m-0 text-sm">
          <a href={`mailto:${person.email}`}>{person.email}</a> ·{' '}
          <a href={person.links.github} rel="noopener">GitHub</a> ·{' '}
          <a href={person.links.linkedin} rel="noopener">LinkedIn</a> ·{' '}
          <a href="/cv">CV</a>
        </p>

        <p class="text-ink mt-6 max-w-[62ch] text-[17px] leading-relaxed">
          {variant.headline}
        </p>

        <div
          class="border-rule bg-surface mt-5 max-w-[62ch] rounded-lg border p-3.5 text-[14px] leading-relaxed"
        >
          <span class="text-ink font-medium">{variant.openTo}</span>
        </div>

        <div class="mt-5">
          <VariantSwitcher current={variant.slug} />
        </div>
      </div>
      <div class="justify-self-end max-[600px]:order-2 max-[600px]:justify-self-start">
        <Portrait />
      </div>
    </header>

    <h2 class="section-label mt-12 mb-5">Experience</h2>
    {currentEra.map((role) => <RoleCard role={role} />)}

    {
      retrospective.length > 0 && (
        <>
          <h2 class="section-label mt-12 mb-2">Career retrospective (2004–2014)</h2>
          <p class="text-muted mt-0 mb-4 max-w-[62ch] text-[14px]">
            Earlier work — collapsed by default. Click any to expand, or ask the chatbot to dig in.
          </p>
          {retrospective.map((role) => (
            <CompressedRoleCard role={role} />
          ))}
        </>
      )
    }

    <LeadershipPhilosophy />

    <h2 class="section-label mt-12 mb-5">Skills</h2>
    <SkillsMatrix />

    {
      openSource.length > 0 && (
        <>
          <h2 class="section-label mt-12 mb-5">Open Source</h2>
          {openSource.map((entry) => (
            <article class="mb-4">
              <h3 class="mb-1 text-lg font-semibold tracking-tight">
                <a href={entry.url} rel="noopener">
                  {entry.name}
                </a>
              </h3>
              <p class="m-0">{entry.description}</p>
            </article>
          ))}
        </>
      )
    }

    <Chat client:load transition:persist="chat" />
  </main>
</Layout>
