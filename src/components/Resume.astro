---
import Layout from '../layouts/Layout.astro';
import Chat from './Chat';
import CompressedRoleCard from './CompressedRoleCard.astro';
import EmailCopyChip from './EmailCopyChip.astro';
import LeadershipPhilosophy from './LeadershipPhilosophy.astro';
import Portrait from './Portrait.astro';
import RoleCard from './RoleCard.astro';
import SkillsMatrix from './SkillsMatrix.astro';
import SocialChip from './SocialChip.astro';
import VariantSwitcher from './VariantSwitcher.astro';
import { CURRENT_ERA_FROM, resume } from '../lib/resume';
import type { Variant } from '../lib/variants';

interface Props {
  variant: Variant;
}

const { variant } = Astro.props;
const { person, experience, openSource } = resume;
const fullName = `${person.first} ${person.last}`;

const currentEra = experience.filter((r) => r.dateRange.from >= CURRENT_ERA_FROM);
const retrospective = experience.filter((r) => r.dateRange.from < CURRENT_ERA_FROM);
---

<Layout title={variant.metaTitle} description={variant.metaDescription}>
  <main class="max-w-page mx-auto px-6 pt-20 pb-28">
    <header
      class="mb-10 grid grid-cols-[1fr_auto] items-start gap-8 max-[600px]:grid-cols-1 max-[600px]:gap-4"
    >
      <div class="min-w-0 max-[600px]:order-1">
        <h1
          class="m-0 mb-3 text-[clamp(2rem,5vw,2.75rem)] leading-[1.05] font-bold tracking-[-0.035em]"
        >
          {fullName}
        </h1>
        <p
          class="text-ink m-0 max-w-[52ch] text-[19px] leading-snug font-medium tracking-[-0.01em]"
        >
          {variant.tagline}
        </p>
        <div class="mt-4 -ml-3 flex flex-wrap items-center gap-1">
          <a class="contact-chip-primary" href={`/cv/print?lens=${variant.slug}`}>Print CV ↗</a>
          <EmailCopyChip email={person.email} />
          <SocialChip network="github" href={person.links.github} />
          <SocialChip network="linkedin" href={person.links.linkedin} />
        </div>

        <ul class="mt-7 max-w-[62ch] list-none space-y-2 p-0">
          {
            variant.proofBullets.map((bullet) => (
              <li class="text-ink flex items-start gap-2.5 text-[15px] leading-[1.45]">
                <span
                  class="bg-accent mt-[0.55em] h-1.5 w-1.5 shrink-0 rounded-full"
                  aria-hidden="true"
                />
                <span>{bullet}</span>
              </li>
            ))
          }
        </ul>

        <div
          class="border-rule bg-surface mt-6 max-w-[62ch] rounded-lg border p-3.5 text-[14px] leading-relaxed"
        >
          <span class="text-ink font-medium">{variant.openTo}</span>
        </div>

        <div class="mt-5">
          <VariantSwitcher current={variant.slug} />
        </div>
      </div>
      <div
        class="justify-self-end max-[600px]:order-2 max-[600px]:mt-8 max-[600px]:justify-self-start"
      >
        <Portrait />
      </div>
    </header>

    <h2 class="section-heading mt-14 mb-6">Experience</h2>
    {currentEra.map((role) => <RoleCard role={role} />)}

    {
      retrospective.length > 0 && (
        <>
          <h2 class="section-label mt-12 mb-2">Career retrospective (2004–2014)</h2>
          <p class="text-muted mt-0 mb-4 max-w-[62ch] text-[14px]">
            Earlier work — collapsed by default. Click any to expand, or ask the chatbot to dig in.
          </p>
          {retrospective.map((role) => (
            <CompressedRoleCard role={role} />
          ))}
        </>
      )
    }

    <LeadershipPhilosophy />

    <h2 class="section-label mt-12 mb-5">Skills</h2>
    <SkillsMatrix />

    {
      openSource.length > 0 && (
        <>
          <h2 class="section-label mt-12 mb-5">Open Source</h2>
          {openSource.map((entry) => (
            <article class="mb-4">
              <h3 class="mb-1 text-lg font-semibold tracking-tight">
                <a href={entry.url} rel="noopener">
                  {entry.name}
                </a>
              </h3>
              <p class="m-0">{entry.description}</p>
            </article>
          ))}
        </>
      )
    }

    <Chat client:idle transition:persist="chat" />
  </main>
</Layout>
