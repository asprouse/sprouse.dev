{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprouse.dev/schemas/resume.schema.json",
  "title": "Resume",
  "description": "Canonical schema for the resume.json data file. Validated at build time; TypeScript types are generated from this schema into src/types/resume.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "person",
    "tagline",
    "summary",
    "experience",
    "education",
    "openSource",
    "technologies",
    "variants"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "person": { "$ref": "#/$defs/Person" },
    "tagline": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical one-line elevator pitch shown on the homepage and OG image. Variant-specific taglines (variants[X].tagline) override per CV lens."
    },
    "summary": { "type": "string", "minLength": 1 },
    "experience": {
      "type": "array",
      "items": { "$ref": "#/$defs/ExperienceEntry" }
    },
    "education": {
      "type": "array",
      "items": { "$ref": "#/$defs/EducationEntry" }
    },
    "openSource": {
      "type": "array",
      "items": { "$ref": "#/$defs/OpenSourceEntry" }
    },
    "technologies": {
      "type": "object",
      "description": "Map of tech slug to TechEntry. Slugs are lowercase, hyphen-separated.",
      "additionalProperties": { "$ref": "#/$defs/TechEntry" },
      "propertyNames": { "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "variants": {
      "type": "object",
      "description": "Positioning variants. Keys are variant slugs (cto, principal, cofounder).",
      "required": ["cto", "principal", "cofounder"],
      "additionalProperties": false,
      "properties": {
        "cto": { "$ref": "#/$defs/VariantEntry" },
        "principal": { "$ref": "#/$defs/VariantEntry" },
        "cofounder": { "$ref": "#/$defs/VariantEntry" }
      }
    }
  },
  "$defs": {
    "Location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["city", "state"],
      "properties": {
        "city": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "minLength": 1 }
      }
    },
    "DateRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}$",
          "description": "YYYY-MM format (e.g. '2018-10')."
        },
        "to": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}$",
          "description": "YYYY-MM format, or null for the current role."
        }
      }
    },
    "Person": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first", "last", "email", "location", "links"],
      "properties": {
        "first": { "type": "string", "minLength": 1 },
        "last": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "format": "email" },
        "location": { "$ref": "#/$defs/Location" },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "required": ["website", "linkedin", "github"],
          "properties": {
            "website": { "type": "string", "format": "uri" },
            "linkedin": { "type": "string", "format": "uri" },
            "github": { "type": "string", "format": "uri" }
          }
        }
      }
    },
    "Project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "technologies"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "technologies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "ExperienceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["company", "title", "location", "dateRange", "description", "projects"],
      "properties": {
        "company": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "location": { "$ref": "#/$defs/Location" },
        "dateRange": { "$ref": "#/$defs/DateRange" },
        "description": { "type": "string" },
        "impactBullets": {
          "type": "array",
          "description": "Outcome-led summary of the role — what was driven and what it produced. 3–6 items, third-person resume tone, each lead with an action verb (Drove, Designed, Shipped, Led).",
          "minItems": 3,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 1 }
        },
        "projects": {
          "type": "array",
          "items": { "$ref": "#/$defs/Project" }
        }
      }
    },
    "EducationEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["school", "location", "date", "degree"],
      "properties": {
        "school": { "type": "string", "minLength": 1 },
        "college": { "type": "string", "minLength": 1 },
        "location": { "$ref": "#/$defs/Location" },
        "date": { "type": "string", "minLength": 1 },
        "honors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "degree": { "type": "string", "minLength": 1 },
        "coursework": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "OpenSourceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "TechCategory": {
      "type": "string",
      "enum": [
        "language",
        "framework",
        "library",
        "platform",
        "ai",
        "tooling",
        "protocol",
        "concept",
        "internal",
        "humor"
      ]
    },
    "TechEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "category", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string" },
        "category": { "$ref": "#/$defs/TechCategory" },
        "description": {
          "type": "string",
          "description": "Tooltip-style explanation. May be empty for techs whose name speaks for itself."
        }
      }
    },
    "VariantEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "tagline", "openTo", "metaTitle", "metaDescription"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable lens name shown in UI (e.g., 'Principal Engineer')."
        },
        "tagline": {
          "type": "string",
          "minLength": 1,
          "description": "One-line elevator pitch shown under the H1."
        },
        "openTo": {
          "type": "string",
          "minLength": 1,
          "description": "What kind of next role Andrew is open to under this lens."
        },
        "metaTitle": { "type": "string", "minLength": 1 },
        "metaDescription": { "type": "string", "minLength": 1 }
      }
    }
  }
}
