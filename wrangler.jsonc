{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "sprouse-dev",
    "main": "./dist/_worker.js/index.js",
    "compatibility_date": "2025-05-01",
    "compatibility_flags": ["nodejs_compat"],
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS"
    },
    "observability": {
        "enabled": true
    }
}
