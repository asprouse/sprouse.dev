{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sprouse-dev",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  // Preserve secrets/vars set via the Cloudflare dashboard (ANTHROPIC_API_KEY,
  // etc.) instead of wiping them on every deploy. Without this, wrangler treats
  // the config as the full source of truth and removes anything not declared here.
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "unsafe": {
    "bindings": [
      {
        "name": "CHAT_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1",
        "simple": {
          "limit": 10,
          "period": 60
        }
      },
      {
        "name": "GLOBAL_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "2",
        "simple": {
          "limit": 60,
          "period": 60
        }
      },
      {
        "name": "TAILOR_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "3",
        "simple": {
          "limit": 5,
          "period": 60
        }
      },
      {
        "name": "FETCH_JD_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "4",
        "simple": {
          "limit": 5,
          "period": 60
        }
      }
    ]
  }
}
