{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "sprouse-dev",
    "main": "./dist/_worker.js/index.js",
    "compatibility_date": "2025-05-01",
    "compatibility_flags": ["nodejs_compat"],
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS"
    },
    "observability": {
        "enabled": true
    },
    "unsafe": {
        "bindings": [
            {
                "name": "CHAT_RATE_LIMITER",
                "type": "ratelimit",
                "namespace_id": "1",
                "simple": {
                    "limit": 10,
                    "period": 60
                }
            },
            {
                "name": "GLOBAL_RATE_LIMITER",
                "type": "ratelimit",
                "namespace_id": "2",
                "simple": {
                    "limit": 60,
                    "period": 60
                }
            }
        ]
    }
}
